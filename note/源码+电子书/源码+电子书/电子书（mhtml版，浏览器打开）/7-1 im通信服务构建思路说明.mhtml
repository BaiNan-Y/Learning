  0% { transform: translate(-50%, -50%) scale(0.1); }
  100% { transform: translate(-50%, -50%) scale(1); }
}

@-webkit-keyframes smallToBig {=20
  0% { transform: translate(-50%, -50%) scale(0.1); }
  100% { transform: translate(-50%, -50%) scale(1); }
}

@keyframes topToBottom {=20
  0% { transform: translateY(0px); }
  100% { transform: translateY(calc(76vh)); }
}

@-webkit-keyframes topToBottom {=20
  0% { transform: translateY(0px) rotate(36deg); }
  100% { transform: translateY(calc(76vh)) rotate(36deg); }
}

@keyframes shake {=20
  50% { transform: rotate(0deg); }
  60% { transform: rotate(20deg); }
  70% { transform: rotate(-20deg); }
  80% { transform: rotate(20deg); }
  90% { transform: rotate(-20deg); }
  100% { transform: rotate(0deg); }
}

@-webkit-keyframes shake {=20
  50% { transform: rotate(0deg); }
  60% { transform: rotate(20deg); }
  70% { transform: rotate(-20deg); }
  80% { transform: rotate(20deg); }
  90% { transform: rotate(-20deg); }
  100% { transform: rotate(0deg); }
}

